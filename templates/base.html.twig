<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SportVie{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="{{ path('home') }}">SportVie</a>
    <div class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link {% if app.request.attributes.get('_route') == 'home' %}active{% endif %}" href="{{ path('home') }}">Accueil</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle {% if app.request.attributes.get('_route') starts with 'sport' %}active{% endif %}" href="#" data-bs-toggle="dropdown">Sports</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="{{ path('sport_show', {'id': 1}) }}">Yoga</a></li>
            <li><a class="dropdown-item" href="{{ path('sport_show', {'id': 2}) }}">TRX</a></li>
            <li><a class="dropdown-item" href="{{ path('sport_show', {'id': 3}) }}">Stretching</a></li>
            <li><a class="dropdown-item" href="{{ path('sport_show', {'id': 4}) }}">Fitness</a></li>
            <li><a class="dropdown-item" href="{{ path('sport_show', {'id': 5}) }}">Natation</a></li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main class="py-4">
    {% block body %}{% endblock %}
</main>

<footer class="bg-dark text-white text-center py-3">
    <p>&copy; 2025 SportVie. Tous droits réservés.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

